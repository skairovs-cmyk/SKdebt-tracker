rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Shared app data: any authenticated user can read and manage records
    match /records/{recordId} {
      allow read, create, update, delete: if isAuthenticated();
    }
    
    // Shared app data: any authenticated user can read and manage incomes
    match /incomes/{incomeId} {
      allow read, create, update, delete: if isAuthenticated();
    }
    
    // Shared settings document: authenticated users share the same custom columns
    match /settings/{userId} {
      allow read, write: if isAuthenticated();
    }
  }
}
